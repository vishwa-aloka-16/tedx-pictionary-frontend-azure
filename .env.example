# Set the public HTTPS backend URL before running npm run build.
VITE_API_URL=http://127.0.0.1:8000

# Phone-accessible frontend URL for artwork QR codes (your computer's LAN IP locally).
# Example: VITE_PUBLIC_FRONTEND_URL=http://192.168.1.10:5173
# Production: VITE_PUBLIC_FRONTEND_URL=https://jkit-tedx.onrender.com
VITE_PUBLIC_FRONTEND_URL=
